# SHIGOKU 統合設定ファイル
# 環境変数は ${VAR_NAME} 形式で展開されます

# モード設定
mode: bugbounty  # bugbounty | vulntest | ctf
ctf_flag_format: "flag{.*}"

# プロジェクト設定
project_name: ""
project_path: ""

# スコープファイル
scope_file: ""

# 通知設定
notification:
  slack_webhook: ${SLACK_WEBHOOK}
  discord_webhook: ${DISCORD_WEBHOOK}
  notify_on_critical: true
  notify_on_high: true

# ワードリスト設定
wordlist:
  base_path: /home/bbb/Documents/tools/wordlists
  subdomain: subdomain/subdomains-top1million-5000.txt
  directory: directory/dicc.txt
  api: api/httparchive_apiroutes.txt
  params: params/params-list.txt

# ツール設定
tools:
  nuclei: true
  nuclei_path: nuclei
  nuclei_templates: ${HOME}/nuclei-templates
  ffuf: true
  ffuf_path: ffuf
  subfinder: true
  amass: true
  gau: true
  
  # カスタムツール
  custom_tools:
    meg:
      path: /home/bbb/Documents/tools/meg-enhanced
      command: "meg -c 50 -v"
      output_format: text
    secretfinder:
      path: /home/bbb/Documents/tools/secretfinder-v2
      command: "secretfinder --json"
      output_format: json

# スキャン設定
scan:
  rate_limit: 50
  timeout: 30
  threads: 10
  max_depth: 3
  follow_redirects: true
  user_agent: "SHIGOKU/1.0"

# 並列実行設定。enabled を false にすると常に直列実行へ戻ります。
parallelism:
  enabled: true
  kill_switch: false
  shadow_mode: true
  default_executor: serial

# VDP段階導入設定（SGK-2026-0420/0421/0423）。既定は off でVDP無効。
vdp:
  mode: "off"          # off | record_only | shadow | readonly_enforce
  # kill_switch: false
  # stage: ""           # m0..m4 の明示stage（"" なら mode から導出）
  # key_provider: "env" # env | file | env_or_file（enforce段階 M3a+ では home フォールバック禁止）
  # key_registry_path: ""   # enforce では必須
  # progression_records_path: ""  # M3b 以上は必須（設定だけで状態変更を有効化できない）
  # thresholds_path: ""       # hidden holdout 用 frozen thresholds

# SGK-2026-0425: VDP診断telemetry（additive。default off で既存出力と bit 単位同一）
diagnostics:
  enabled: false      # false: 診断event収集なし。true: 収集
  required: false     # true: hook失敗時は次の通信前に停止・checkpoint・Hold
  max_events: 2000
  max_artifact_bytes: 10485760
  checkpoint_interval_events: 500
  event_queue_capacity: 5000

# LLM統合設定 (Phase 1 - providers/profiles/roles による一元管理)
llm:
  schema_version: 1
  default_role: specialist_light
  providers:
    deepseek:
      api_key_env: DEEPSEEK_API_KEY
      base_url: https://api.deepseek.com/v1
    openai:
      api_key_env: OPENAI_API_KEY
      base_url: https://api.openai.com/v1
    any_llm:
      api_key_env: ANY_LLM_API_KEY
      base_url: http://localhost:8000/v1

  profiles:
    cheap_api:
      provider: deepseek
      model: deepseek/deepseek-v4-flash
      timeout_seconds: 300
      max_retries: 2
      max_concurrency: 4
      rate_limit_per_minute: 60
      temperature: 0.0
      extra:
        thinking:
          type: disabled
          reasoning_effort: null
    reasoning_api:
      provider: deepseek
      model: deepseek/deepseek-v4-pro
      timeout_seconds: 300
      max_retries: 2
      max_concurrency: 2
      rate_limit_per_minute: 30
      temperature: 0.0
      extra:
        thinking:
          type: enabled
          reasoning_effort: high
    vision_api:
      provider: openai
      model: openai/gpt-4o
      timeout_seconds: 300

  roles:
    planner:
      profile: reasoning_api
      fallback_profile: cheap_api
      system_prompt_template: conductor/planning.md
    swarm_manager:
      profile: cheap_api
      fallback_profile: reasoning_api
      system_prompt_template: agents/manager_base.md
    tool_output_analysis:
      profile: cheap_api
      fallback_profile: reasoning_api
      system_prompt_template: roles/tool_output_analysis.md
    rag_compression:
      profile: cheap_api
      system_prompt_template: roles/rag_compression.md
    final_judgement:
      profile: reasoning_api
      fallback_profile: cheap_api
      system_prompt_template: roles/final_judgement.md
    specialist_light:
      profile: cheap_api
      fallback_profile: reasoning_api
      system_prompt_template: roles/specialist_light.md
    xss_specialist:
      profile: cheap_api
      fallback_profile: reasoning_api
      system_prompt_template: roles/xss_specialist.md
    xss_rejudge:
      profile: cheap_api
      fallback_profile: reasoning_api
      system_prompt_template: roles/xss_specialist.md
    xss_final:
      profile: reasoning_api
      fallback_profile: cheap_api
      system_prompt_template: roles/xss_specialist.md
    ops_intent:
      profile: cheap_api
      fallback_profile: reasoning_api
      system_prompt_template: roles/ops_intent.md
    vision_analysis:
      profile: vision_api
      fallback_profile: cheap_api
      system_prompt_template: roles/vision_analysis.md
      optional: true

ops_intent:
  feature_flag: true
  kill_switch: false
  llm_parse_timeout_sec: 15
  command_timeout_sec: 900
  retry_budget: 0
  max_attack_targets_per_run: 25
  non_tty_policy: fail_closed
  daily_llm_budget: 25

# 外部API設定
api:
  shodan_api_key: ${SHODAN_API_KEY}
  censys_api_id: ${CENSYS_API_ID}
  censys_api_secret: ${CENSYS_API_SECRET}
  hunter_api_key: ${HUNTER_API_KEY}
  virustotal_api_key: ${VIRUSTOTAL_API_KEY}

# RAG設定
rag_enabled: true
obsidian_vault_path: ${HOME}/Documents/Obsidian/Security
chromadb_path: ${HOME}/.shigoku/chromadb

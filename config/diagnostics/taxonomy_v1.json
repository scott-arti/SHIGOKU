  "stage_details": {
    "S00": {
      "name": "execution_contract_prep",
      "reached_when": "対象面取得を始めるための許可・scope・target identity・初期budgetが評価可能",
      "failure_examples": [
        "対象の許可・scope・識別が不明で、安全に探索を開始できない"
      ]
    },
    "S01": {
      "name": "surface_acquisition",
      "reached_when": "期待ケースに対応するraw producer artifactが存在",
      "failure_examples": [
        "crawl・proxy・schema・browser等の探索範囲に入らない"
      ]
    },
    "S02": {
      "name": "observation_normalization",
      "reached_when": "raw artifactからtyped Observationが生成",
      "failure_examples": [
        "parser skip、正規化衝突、情報欠落、鮮度誤判定"
      ]
    },
    "S03": {
      "name": "hypothesis_generation",
      "reached_when": "capability/actor/trust boundaryが一致するHypothesisRecordが存在",
      "failure_examples": [
        "観測を脆弱性仮説へ変換できない、誤った能力へ分類"
      ]
    },
    "S04": {
      "name": "prioritization",
      "reached_when": "仮説が予算内の実行候補として選択",
      "failure_examples": [
        "diversity、ranking、探索枠、stop方針で正しい仮説が飢餓化"
      ]
    },
    "S05": {
      "name": "admission",
      "reached_when": "scope/capability/budget/HITL gateが期待どおり許可または理由付き拒否",
      "failure_examples": [
        "安全上正当でないblock、必要前提を無視した許可、budget部分消費"
      ]
    },
    "S06": {
      "name": "routing",
      "reached_when": "適合specialist/tool/recipeと必要依存へ割り当て",
      "failure_examples": [
        "誤specialist、能力不足tool、recipe不一致、必要依存unavailable"
      ]
    },
    "S07": {
      "name": "attempt_design",
      "reached_when": "actor・owner・method・入力位置・baseline・attack・inverse・falsificationが整合するAttemptSpecを構成",
      "failure_examples": [
        "payload位置違い、比較actor違い、control不足、success条件不整合"
      ]
    },
    "S08": {
      "name": "execution_transport",
      "reached_when": "許可されたrequestが一度だけ送信され、応答または明示的失敗を記録",
      "failure_examples": [
        "未送信、timeout、proxy/browser/OOB停止、二重送信防止block"
      ]
    },
    "S09": {
      "name": "response_interpretation",
      "reached_when": "応答差・marker・状態差・timing等を構造化markerへ変換",
      "failure_examples": [
        "実レスポンスに信号があるのにAI/parserが意味を取れない"
      ]
    },
    "S10": {
      "name": "evidence_completion",
      "reached_when": "required_evidenceと独立controlがすべて同一lineageに揃う",
      "failure_examples": [
        "第2actor、read-back、再訪問、相関OOB、統計反復が不足"
      ]
    },
    "S11": {
      "name": "adjudication",
      "reached_when": "Evidence Validatorがcandidate/confirmed/refuted/untestedを根拠付きで出力",
      "failure_examples": [
        "十分な証拠を誤って保留・反証、理由不明confirmed"
      ]
    },
    "S12": {
      "name": "report_projection",
      "reached_when": "canonical verdictと証拠参照がreportへ欠落なく投影されconsistent",
      "failure_examples": [
        "sessionでは成立したがreport/gateで欠落・誤集計"
      ]
    },
    "U00": {
      "name": "undeterminable",
      "reached_when": "必要telemetryの欠損を具体的に記録",
      "failure_examples": [
        "古いsessionにraw producer履歴が無く、S01かS02か断定不能"
      ]
    }
  },
